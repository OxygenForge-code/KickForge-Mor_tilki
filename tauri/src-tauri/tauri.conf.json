{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KickForge",
  "version": "2.3.0",
  "identifier": "com.oxygenforge.kickforge",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KickForge · mor tilki",
        "width": 1200,
        "height": 780,
        "minWidth": 820,
        "minHeight": 580,
        "decorations": false,
        "backgroundColor": "#0b0d0a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
