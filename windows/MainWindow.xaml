<Window x:Class="KickForgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KickForge · mor tilki" Height="780" Width="1200" MinWidth="820" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <sh:WindowChrome.WindowChrome>
        <sh:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                         CornerRadius="0" UseAeroCaptionButtons="False" />
    </sh:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- durum çubuğundaki küçük bağlantı düğmeleri -->
        <Style x:Key="StatusLink" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- dock cam parlaması: merkezi fare konumuna göre taşınır -->
        <RadialGradientBrush x:Key="DockSheen" MappingMode="RelativeToBoundingBox"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.38" RadiusY="0.85">
            <GradientStop Color="#2EFFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.45" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </RadialGradientBrush>
    </Window.Resources>

    <Grid x:Name="Root">

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ortam isigi: cam yuzeylerin arkasinda kirilan renk bulutlari -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Fill="{DynamicResource AmbientA}" Width="720" Height="540" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="-260,-290,0,0" />
            <Ellipse Fill="{DynamicResource AmbientB}" Width="660" Height="520" HorizontalAlignment="Right"
                     VerticalAlignment="Bottom" Margin="0,0,-230,-250" />
            <Ellipse Fill="{DynamicResource AmbientA}" Width="440" Height="380" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,-190,-150,0" Opacity="0.4" />
        </Grid>

        <!-- başlık çubuğu -->
        <Grid Grid.Row="0" Background="{DynamicResource GlassFill2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- baslik cubugu ile icerigi ayiran cam kenar -->
            <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource GlassEdge}" IsHitTestVisible="False" />

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- isaret: cam kenarli accent kutu -->
                <Grid Width="24" Height="24">
                    <Border CornerRadius="7" Background="{DynamicResource PrimaryFill}" />
                    <Border CornerRadius="7" BorderThickness="1" BorderBrush="#33FFFFFF" />
                    <Path Data="M 0,0 L 0,8 L 6,4 Z" Fill="{DynamicResource AccentInk}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Stretch="None" />
                </Grid>
                <TextBlock Text="KICKFORGE" Style="{StaticResource Caption}" FontSize="11" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                <TextBlock x:Name="TitleChannel" Text="· mor tilki" Style="{StaticResource Caption}" FontSize="11"
                           Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.62" />
                <Border Width="1" Height="16" Margin="14,0,0,0" Background="{DynamicResource Line}"
                        VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                <Border x:Name="HeaderState" Style="{StaticResource Chip}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderStateText" Text="BAĞLANIYOR" Style="{StaticResource Mono}" FontSize="9.5"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="NavSettings_Click" ToolTip="ayarlar">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Minimize_Click" ToolTip="küçült">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Maximize_Click" ToolTip="büyüt">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource CloseBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" ToolTip="kapat">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- sayfa içeriği (tam genişlik) -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="14,12,14,0" />

        <!-- güncelleme bildirimi: alt sağdan süzülerek gelen cam hap -->
        <Border x:Name="UpdateToast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,18" MaxWidth="340" CornerRadius="18" Padding="16,14"
                Background="{DynamicResource GlassFill3}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                Visibility="Collapsed" RenderTransformOrigin="1,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="UpdateToastShift" Y="14" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="7" Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="9" Background="{DynamicResource PrimaryFill}">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentInk}" />
                    </Border>
                    <TextBlock Text="güncelleme var" Style="{StaticResource H2}" FontSize="13"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="UpdateNote" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="UpdateInstall" Content="şimdi kur" Style="{StaticResource Primary}"
                            Click="UpdateInstall_Click" />
                    <Button Content="sürüm notları" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                            Click="UpdateNotes_Click" />
                    <Button Content="sonra" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                            Click="UpdateLater_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- alt dock: kanal şeridi solda, sekmeler ortada, liquid glass yüzey -->
        <Border x:Name="Dock" Grid.Row="2" Margin="14,12,14,10" CornerRadius="24" Padding="14,9"
                BorderThickness="1" BorderBrush="{DynamicResource GlassEdge}"
                Background="{DynamicResource GlassFill3}"
                MouseMove="Dock_MouseMove" MouseLeave="Dock_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <!-- cam parlaması: fareyi takip eder (kod tarafında taşınır) -->
                <Border x:Name="DockSheenLayer" CornerRadius="23" IsHitTestVisible="False"
                        Background="{StaticResource DockSheen}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- üst kenarda ince spekülar çizgi -->
                    <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Margin="30,0"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#7AFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- kanal kartı: dikeyken soldaydı, artık dock içinde yatay şerit -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,20,0">
                        <Grid Width="38" Height="38">
                            <Ellipse Fill="{DynamicResource Surface3}" />
                            <Ellipse x:Name="AvatarEllipse">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- cam halka -->
                            <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="168">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChannelName" Text="mor tilki" Style="{StaticResource H2}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border x:Name="VerifiedChip" Background="{DynamicResource Accent2}" CornerRadius="8"
                                        Padding="5,0" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="✓" FontSize="9" Foreground="{DynamicResource AccentInk}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ChannelMeta" Text="takipçi yükleniyor…" Style="{StaticResource Caption}"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border x:Name="SideLive" Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideLiveDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SideLiveText" Text="yayın kapalı" Style="{StaticResource Mono}" FontSize="10"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- sekmeler -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="NavLive" Style="{StaticResource DockNav}" Content="canlı" Tag="&#xE7F4;"
                                     IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavStudio" Style="{StaticResource DockNav}" Content="yayın &amp; sohbet"
                                     Tag="&#xE714;" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavHistory" Style="{StaticResource DockNav}" Content="geçmiş"
                                     Tag="&#xE81C;" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource DockNav}" Content="ayarlar"
                                     Tag="&#xE713;" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource DockNav}" Content="hakkında"
                                     Tag="&#xE946;" Checked="Nav_Checked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- durum çubuğu -->
        <Grid Grid.Row="3" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="bağlantı kuruluyor…" Style="{StaticResource Caption}" Margin="7,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="StatusHint" Grid.Column="1" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusRight" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <Border Width="1" Height="12" Margin="10,0,9,0" Background="{DynamicResource Line}"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="sürüm 2.3.0 · native" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
                <Button Content="site" Style="{StaticResource StatusLink}" Click="OpenSite_Click" />
                <Button Content="github" Style="{StaticResource StatusLink}" Click="OpenGithub_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
