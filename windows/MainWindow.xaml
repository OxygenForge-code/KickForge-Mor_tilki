<Window x:Class="KickForgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KickForge · mor tilki" Height="780" Width="1200" MinWidth="900" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <sh:WindowChrome.WindowChrome>
        <sh:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                         CornerRadius="0" UseAeroCaptionButtons="False" />
    </sh:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- başlık çubuğu -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Accent}">
                    <Path Data="M 0,0 L 0,8 L 6,4 Z" Fill="{DynamicResource AccentInk}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Stretch="None" />
                </Border>
                <TextBlock Text="KICKFORGE" Style="{StaticResource Caption}" FontSize="11" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                <TextBlock x:Name="TitleChannel" Text="· mor tilki" Style="{StaticResource Caption}" FontSize="11"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                <Border x:Name="HeaderState" Style="{StaticResource Chip}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderStateText" Text="BAĞLANIYOR" Style="{StaticResource Mono}" FontSize="9.5"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="NavSettings_Click" ToolTip="ayarlar">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Minimize_Click" ToolTip="küçült">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource IconBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Maximize_Click" ToolTip="büyüt">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource Glyph}" />
                </Button>
                <Button Style="{StaticResource CloseBtn}" sh:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" ToolTip="kapat">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- gövde -->
        <Grid Grid.Row="1" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- kanal kartı -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="42" Height="42">
                                <Ellipse Fill="{DynamicResource Surface3}" />
                                <Ellipse x:Name="AvatarEllipse">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChannelName" Text="mor tilki" Style="{StaticResource H2}" />
                                    <Border x:Name="VerifiedChip" Background="{DynamicResource Accent2}" CornerRadius="8"
                                            Padding="5,0" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="✓" FontSize="9" Foreground="{DynamicResource AccentInk}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ChannelMeta" Text="takipçi yükleniyor…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="SideLive" Style="{StaticResource Chip}" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideLiveDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SideLiveText" Text="yayın kapalı" Style="{StaticResource Mono}" FontSize="10"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- menü -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <RadioButton x:Name="NavLive" Style="{StaticResource Nav}" Content="canlı" Tag="&#xE7F4;" IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" Content="geçmiş" Tag="&#xE81C;"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="ayarlar" Tag="&#xE713;"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Content="hakkında" Tag="&#xE946;"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <!-- alt bilgi -->
                <StackPanel Grid.Row="3" Margin="0,0,0,6">
                    <TextBlock x:Name="VersionText" Text="sürüm 2.0.0 · native" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="site" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5"
                                Click="OpenSite_Click" />
                        <Button Content="github" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5"
                                Margin="6,0,0,0" Click="OpenGithub_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,0,0,0" />
        </Grid>

        <!-- durum çubuğu -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="bağlantı kuruluyor…" Style="{StaticResource Caption}" Margin="7,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="StatusHint" Grid.Column="1" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusRight" Text="" Style="{StaticResource Caption}" />
                <TextBlock Text=" · native wpf" Style="{StaticResource Caption}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
