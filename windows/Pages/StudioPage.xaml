<UserControl x:Class="KickForgeDesktop.Pages.StudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:KickForgeDesktop.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- sohbet satırı: genel listeden daha sıkı, çünkü mesaj çok oluyor -->
        <Style x:Key="ChatItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Padding="8,4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- üst şerit: tamamı native -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="LiveChip" Style="{StaticResource Chip}" Background="{DynamicResource Surface2}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                        <TextBlock x:Name="LiveText" Text="YAYIN KAPALI" Style="{StaticResource Mono}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ViewerText" Text="" Style="{StaticResource Mono}" FontSize="11" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" />
            </StackPanel>

            <TextBlock x:Name="TitleText" Grid.Column="1" Text="" Style="{StaticResource Mono}" FontSize="11"
                       Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MuteButton" Content="sesi aç" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5" />
                <Button x:Name="ReloadButton" Content="yenile" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5" Margin="6,0,0,0" />
                <Button x:Name="OpenButton" Content="kick'te aç" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5" Margin="6,0,0,0" />
                <Button x:Name="ChatToggle" Content="sohbeti gizle" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11.5" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- oynatıcı + sohbet -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" MinWidth="300" />
                <ColumnDefinition x:Name="ChatColumn" Width="*" MinWidth="288" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <Border Background="#000000" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="#0B0A10" />

                    <Border x:Name="Overlay" Background="{DynamicResource Bg}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
                            <TextBlock x:Name="OverlayTitle" Text="oynatıcı hazırlanıyor…" Style="{StaticResource H1}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="OverlayText" Text="" Style="{StaticResource Body}" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button Content="kick'te aç" Style="{StaticResource Primary}" Click="OverlayOpen_Click" />
                                <Button Content="yeniden dene" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                        Click="OverlayRetry_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ChatPanel" Grid.Column="1" Margin="10,0,0,0"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- başlık -->
                    <Grid Margin="14,11,10,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="sohbet" Style="{StaticResource H2}" />
                                <Border x:Name="ChatCountChip" Style="{StaticResource Chip}" Background="{DynamicResource Surface2}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,1">
                                    <TextBlock x:Name="ChatCount" Text="—" Style="{StaticResource Mono}" FontSize="9.5"
                                               Foreground="{DynamicResource TextDim}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ChatState" Text="bağlanıyor…" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="AuthButton" Grid.Column="1" Content="giriş yap" Style="{StaticResource Ghost}"
                                Padding="10,5" FontSize="11" VerticalAlignment="Center" Click="Auth_Click" />
                    </Grid>

                    <!-- mesajlar -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ChatList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ChatItem}"
                                 Margin="6,0,6,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.ScrollChanged="ChatList_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="17"
                                               ToolTip="{Binding Tooltip, Mode=OneWay}"
                                               chat:ChatLine.Message="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="ChatEmpty" Text="sohbet sakin…&#x0a;mesaj gelince burada görünür."
                                   Style="{StaticResource Caption}" TextAlignment="Center" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />

                        <!-- kullanıcı yukarı kaydırdıysa yeni mesajı kaçırmasın -->
                        <Button x:Name="JumpButton" Content="yeni mesajlar ↓" Style="{StaticResource Primary}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Padding="10,4" FontSize="10.5" Visibility="Collapsed" Click="Jump_Click" />
                    </Grid>

                    <!-- yazma -->
                    <Grid Grid.Row="2" Margin="10,6,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource Field}" IsEnabled="False"
                                 MaxLength="500" KeyDown="ChatInput_KeyDown" />
                        <Button x:Name="SendButton" Grid.Column="1" Content="gönder" Style="{StaticResource Primary}"
                                Margin="6,0,0,0" Padding="12,8" FontSize="11.5" Click="Send_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
