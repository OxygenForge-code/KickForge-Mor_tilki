<UserControl x:Class="KickForgeDesktop.Pages.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KickForgeDesktop.Controls">
    <UserControl.Resources>
        <!-- olcu kutusu icindeki etiket: kucuk, aralikli, soluk -->
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SlimScrollHost}" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- büyük durum kartı -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="272" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Tally" Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TallyDot" Width="7" Height="7" Fill="{DynamicResource TextDim}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="TallyText" Text="OFF AIR" Style="{StaticResource Mono}" FontSize="10"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="StaleChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="eski veri" Style="{StaticResource Mono}" FontSize="10"
                                           Foreground="{DynamicResource Warn}" />
                            </Border>
                            <Border x:Name="TrayChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="tepside" Style="{StaticResource Mono}" FontSize="10"
                                           Foreground="{DynamicResource TextDim}" />
                            </Border>
                        </StackPanel>

                        <!-- izleyici sayisi: ekranin tek buyuk rakami -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock x:Name="ViewerText" Text="—" Style="{StaticResource Num}" />
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,0,14">
                                <TextBlock x:Name="ViewerLabel" Text="izleyici" Style="{StaticResource Caption}" />
                                <Border Width="52" Height="2" CornerRadius="1" Margin="0,6,0,0"
                                        Background="{DynamicResource Accent}" Opacity="0.55" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TitleText" Text="kanal verisi bekleniyor…" Style="{StaticResource Body}"
                                   Margin="0,6,0,0" MaxHeight="48" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnWatch" Content="yayını aç" Style="{StaticResource Primary}" />
                            <Button x:Name="BtnChat" Content="sohbeti aç" Style="{StaticResource Ghost}" Margin="8,0,0,0" />
                            <Button x:Name="BtnRefresh" Content="yenile" Style="{StaticResource Ghost}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- sag kolon: cam olcu kutulari -->
                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Tile}" Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="TAKİPÇİ" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="FollowerText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="OTURUM" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="KAYNAK" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="SourceText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="GECİKME" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="2" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="KANAL NO" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="ChannelIdText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="2" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="GÜNCELLEME" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="UpdatedText" Text="—" Style="{StaticResource Metric}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- eski veri uyarısı -->
            <Border x:Name="StaleBar" Style="{StaticResource Card}"
                    Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StaleText" Text="kanala ulaşılamıyor" Style="{StaticResource H2}"
                                   Foreground="{DynamicResource Warn}" />
                        <TextBlock Text="Kick bazı IP'leri ara ara engelliyor; elimizdeki son iyi veriyi gösteriyoruz."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="tekrar dene" Style="{StaticResource Ghost}" VerticalAlignment="Center"
                            Click="Retry_Click" />
                </Grid>
            </Border>

            <!-- eğri -->
            <Border x:Name="SparkCard" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="izleyici eğrisi" Style="{StaticResource H2}" />
                            <TextBlock Text=" · native, sunucuya gitmiyor" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="6,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SparkSummary" Grid.Column="1" Text="veri toplanıyor…" Style="{StaticResource Mono}"
                                   FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </Grid>
                    <controls:Sparkline x:Name="Spark" Height="96" Margin="0,16,0,0"
                                        LineBrush="{DynamicResource Accent}" FillBrush="{DynamicResource Accent2}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EN YÜKSEK" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="PeakText" Text="—" Style="{StaticResource Metric}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ORTALAMA" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="AvgText" Text="—" Style="{StaticResource Metric}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ÖRNEK" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="SampleText" Text="—" Style="{StaticResource Metric}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- alt kartlar -->
            <Grid x:Name="BottomRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="bağlantı" Style="{StaticResource H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{DynamicResource TextDim}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnText" Text="kuruluyor…" Style="{StaticResource Mono}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ConnDetail" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="siteyi aç" Style="{StaticResource Ghost}" Click="OpenSite_Click" />
                            <Button Content="günlüğü aç" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OpenLog_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="hızlı ayar" Style="{StaticResource H2}" />
                        <CheckBox x:Name="TopToggle" Content="her zaman üstte" Style="{StaticResource Switch}" Margin="0,14,0,0"
                                  Checked="TopToggle_Changed" Unchecked="TopToggle_Changed" />
                        <CheckBox x:Name="TrayToggle" Content="kapatınca tepside kal" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                  Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="bildirim sesini dene" Style="{StaticResource Ghost}" Click="TestSound_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
